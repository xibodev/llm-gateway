# Copy to deploy/.env and fill in. NEVER commit the real .env.
#
# Admin API key your CLIs send as the bearer token (or mint per-project keys in /admin).
LLMGW_API_KEY=
LLMGW_IMAGE=ghcr.io/xibodev/llm-gateway:<version>
LLMGW_DOMAIN=llm.example.com

# Keep authentication ON in production.
LLMGW_ALLOW_UNAUTHENTICATED_API=0

# Enable the GitHub Copilot provider (personal-use grey area; keep on your own box).
LLMGW_EXPERIMENTAL_COPILOT_PROVIDER=1

# Required for revealable API keys and encrypted provider credentials. Generate 32 random bytes:
#   openssl rand -base64 32
LLMGW_CREDENTIAL_ENCRYPTION_KEY=

# Authentik/Caddy SSO assertion verification. Caddy must overwrite
# X-LLMGW-SSO-Secret and forward X-Authentik-* identity headers.
LLMGW_SSO_ENABLED=0
LLMGW_SSO_SHARED_SECRET=
LLMGW_SSO_ADMIN_GROUP=llmgw-admin
LLMGW_SSO_AUTO_PROVISION=1

# Optional provider discovery feed. No network refresh until URL is set.
# Set false to disable background refresh; the admin Refresh roster button still works.
LLMGW_PROVIDER_ROSTER_AUTO_REFRESH=true
LLMGW_PROVIDER_ROSTER_URL=
# Optional: set a base64 Ed25519 public key to require signed envelopes.
# When absent, the feed is consumed as plain HTTPS JSON.
LLMGW_PROVIDER_ROSTER_PUBLIC_KEY=

# Optional metadata logging. Body capture is a separate unsafe opt-in.
LLMGW_LOG_REQUESTS=0
LLMGW_LOG_REQUEST_BODIES=0
LLMGW_LOG_REQUESTS_MAX_BYTES=104857600

# Bounded operational history. Values below the safe minimum fall back to these defaults.
LLMGW_RETENTION_USAGE_DAYS=90
LLMGW_RETENTION_AUDIT_DAYS=365
LLMGW_RETENTION_DELIVERED_OUTBOX_DAYS=400
LLMGW_BACKUP_KEEP=7
