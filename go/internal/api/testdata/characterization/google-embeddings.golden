# Embeddings, AI Studio
request: POST /v1/embeddings
status: 200
header Content-Type: application/json
upstream: POST /studio/v1beta/models/gemini-embedding-fixture:embedContent
upstream body: {"content":{"parts":[{"text":"Say hello"}]}}
body:
{
  "data": [
    {
      "embedding": [
        0.25,
        -0.5
      ],
      "index": 0,
      "object": "embedding"
    }
  ],
  "model": "gemini-embedding-fixture",
  "object": "list",
  "usage": {
    "prompt_tokens": 2,
    "total_tokens": 2
  }
}
# Embeddings, Vertex AI
request: POST /v1/embeddings
status: 200
header Content-Type: application/json
upstream: POST /vertex/v1/projects/fixture-project/locations/global/publishers/google/models/text-embedding-fixture:predict
upstream body: {"instances":[{"content":"first"}]}
upstream: POST /vertex/v1/projects/fixture-project/locations/global/publishers/google/models/text-embedding-fixture:predict
upstream body: {"instances":[{"content":"second"}]}
body:
{
  "data": [
    {
      "embedding": [
        0.75
      ],
      "index": 0,
      "object": "embedding"
    },
    {
      "embedding": [
        0.75
      ],
      "index": 1,
      "object": "embedding"
    }
  ],
  "model": "text-embedding-fixture",
  "object": "list",
  "usage": {
    "prompt_tokens": 6,
    "total_tokens": 6
  }
}
# Embeddings refused upstream, AI Studio
request: POST /v1/embeddings
status: 404
header Content-Type: application/json
upstream: POST /studio/v1beta/models/missing-embedding-fixture:embedContent
upstream body: {"content":{"parts":[{"text":"Say hello"}]}}
body:
{
  "error": {
    "code": "404",
    "message": "Upstream provider request failed.",
    "type": "invalid_request_error"
  }
}
