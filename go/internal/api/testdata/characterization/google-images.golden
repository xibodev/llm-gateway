# Image generation, Vertex AI
request: POST /v1/images/generations
status: 200
header Content-Type: application/json
header X-Request-Id: <generated req_>
upstream: POST /vertex/v1/projects/fixture-project/locations/global/publishers/google/models/gemini-image-fixture:generateContent
upstream body: {"contents":[{"parts":[{"text":"an origami crane"}],"role":"user"}],"generationConfig":{"responseModalities":["TEXT","IMAGE"]}}
body:
{
  "created": "<time>",
  "data": [
    {
      "b64_json": "iVBORw0KGgo=",
      "mime_type": "image/png"
    }
  ],
  "model": "gemini-image-fixture"
}
