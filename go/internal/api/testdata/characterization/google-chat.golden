# Messages translated to Chat, AI Studio
request: POST /v1/messages
status: 200
header Content-Type: application/json
header X-Llmgw-Transport-Mode: translated
upstream: POST /studio/v1beta/models/gemini-fixture:generateContent
upstream body: {"contents":[{"parts":[{"text":"Say hello"}],"role":"user"}],"generationConfig":{"maxOutputTokens":64},"systemInstruction":{"parts":[{"text":"Answer briefly."}]}}
body:
{
  "content": [
    {
      "text": "Hello from Gemini",
      "type": "text"
    }
  ],
  "id": "<generated chatcmpl->",
  "model": "gemini-fixture",
  "role": "assistant",
  "stop_reason": "end_turn",
  "stop_sequence": null,
  "type": "message",
  "usage": {
    "input_tokens": 3,
    "output_tokens": 4
  }
}
