# Chat Completions, AI Studio
request: POST /v1/chat/completions
status: 200
header Content-Type: application/json
header X-Llmgw-Attempts: 1
header X-Llmgw-Duration-Ms: <ms>
header X-Llmgw-Fallback-Ms: <ms>
header X-Llmgw-Prompt-Bytes: 111
header X-Llmgw-Tool-Schema-Bytes: 0
header X-Llmgw-Transport-Mode: translated
header X-Llmgw-Ttfb-Ms: <ms>
upstream: POST /studio/v1beta/models/gemini-fixture:generateContent
upstream body: {"contents":[{"parts":[{"text":"Say hello"}],"role":"user"}],"generationConfig":{"maxOutputTokens":64,"temperature":0.2},"systemInstruction":{"parts":[{"text":"Answer <briefly> & kindly."}]}}
body:
{
  "choices": [
    {
      "finish_reason": "stop",
      "index": 0,
      "message": {
        "content": "Hello from Gemini",
        "role": "assistant"
      }
    }
  ],
  "id": "<generated chatcmpl->",
  "model": "gemini-fixture",
  "object": "chat.completion",
  "usage": {
    "completion_tokens": 4,
    "prompt_tokens": 3,
    "total_tokens": 7
  }
}
# Chat Completions stream, AI Studio
request: POST /v1/chat/completions
status: 502
header Content-Type: application/json
body:
{
  "error": {
    "code": "502",
    "message": "ai_studio: streaming is not implemented for this provider yet; use a non-streaming request",
    "type": "api_error"
  }
}
