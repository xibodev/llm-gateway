header X-Llmgw-Duration-Ms: <ms>
header X-Llmgw-Fallback-Ms: <ms>
header X-Llmgw-Prompt-Bytes: 111
header X-Llmgw-Tool-Schema-Bytes: 0
header X-Llmgw-Ttfb-Ms: <ms>
upstream: POST /vertex/v1/projects/fixture-project/locations/global/publishers/google/models/gemini-billing-fixture:generateContent
upstream body: {"contents":[{"parts":[{"text":"Say hello"}],"role":"user"}],"generationConfig":{"maxOutputTokens":64,"temperature":0.2},"systemInstruction":{"parts":[{"text":"Answer <briefly> & kindly."}]}}
body:
{
  "error": {
    "code": "429",
    "message": "vertex_ai: provider billing exhausted — Your prepayment credits are depleted.",
    "type": "invalid_request_error"
  }
}
