# Chat Completions to a reasoning model, forced adaptation
request: POST /v1/chat/completions
status: 200
header Content-Type: application/json
header X-Llmgw-Attempts: 1
header X-Llmgw-Duration-Ms: <ms>
header X-Llmgw-Fallback-Ms: <ms>
header X-Llmgw-Prompt-Bytes: 39
header X-Llmgw-Tool-Schema-Bytes: 0
header X-Llmgw-Transport-Mode: native
header X-Llmgw-Ttfb-Ms: <ms>
upstream: POST /ad/chat/completions
upstream body: {"max_completion_tokens":64,"messages":[{"content":"Say hello","role":"user"}],"model":"reasoning-fixture","stream":false}
body:
{
  "choices": [
    {
      "finish_reason": "stop",
      "index": 0,
      "message": {
        "content": "Hello from chat",
        "role": "assistant"
      }
    }
  ],
  "created": "<time>",
  "id": "chatcmpl_fixture",
  "model": "reasoning-fixture",
  "object": "chat.completion",
  "usage": {
    "completion_tokens": 4,
    "prompt_tokens": 3,
    "total_tokens": 7
  }
}
# Chat Completions stream to a reasoning model, forced adaptation
request: POST /v1/chat/completions
status: 200
header Cache-Control: no-cache
header Connection: keep-alive
header Content-Type: text/event-stream
header X-Llmgw-Prompt-Bytes: 39
header X-Llmgw-Tool-Schema-Bytes: 0
header X-Llmgw-Ttfb-Ms: <ms>
upstream: POST /ad/chat/completions
upstream body: {"max_completion_tokens":64,"messages":[{"content":"Say hello","role":"user"}],"model":"reasoning-fixture","stream":true}
body:
data: {"choices":[{"delta":{"content":"Hello","role":"assistant"},"finish_reason":null,"index":0}],"created":"<time>","id":"chatcmpl_fixture","model":"reasoning-fixture","object":"chat.completion.chunk"}

data: {"choices":[{"delta":{"content":" from chat"},"finish_reason":null,"index":0}],"created":"<time>","id":"chatcmpl_fixture","model":"reasoning-fixture","object":"chat.completion.chunk"}

data: {"choices":[{"delta":{},"finish_reason":"stop","index":0}],"created":"<time>","id":"chatcmpl_fixture","model":"reasoning-fixture","object":"chat.completion.chunk","usage":{"completion_tokens":4,"prompt_tokens":3,"total_tokens":7}}

data: [DONE]
# Chat Completions, keyless Pollinations
request: POST /v1/chat/completions
status: 200
header Content-Type: application/json
header X-Llmgw-Attempts: 1
header X-Llmgw-Duration-Ms: <ms>
header X-Llmgw-Fallback-Ms: <ms>
header X-Llmgw-Prompt-Bytes: 39
header X-Llmgw-Tool-Schema-Bytes: 0
header X-Llmgw-Transport-Mode: native
header X-Llmgw-Ttfb-Ms: <ms>
upstream: POST /po/v1/chat/completions
upstream body: {"max_tokens":64,"messages":[{"content":"Say hello","role":"user"}],"model":"openai-fast","stream":false}
body:
{
  "choices": [
    {
      "finish_reason": "stop",
      "index": 0,
      "message": {
        "content": "Hello from chat",
        "role": "assistant"
      }
    }
  ],
  "created": "<time>",
  "id": "chatcmpl_fixture",
  "model": "openai-fast",
  "object": "chat.completion",
  "usage": {
    "completion_tokens": 4,
    "prompt_tokens": 3,
    "total_tokens": 7
  }
}
# Stream refused upstream, keyless Pollinations
request: POST /v1/chat/completions
status: 429
header Content-Type: application/json
upstream: POST /po/v1/chat/completions
upstream body: {"max_tokens":64,"messages":[{"content":"Say hello","role":"user"}],"model":"throttled-fixture","stream":true}
body:
{
  "error": {
    "code": "429",
    "message": "openai: upstream returned 429: fixture rate limit",
    "type": "invalid_request_error"
  }
}
