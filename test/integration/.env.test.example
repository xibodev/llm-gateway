# Sealed integration environment — copy to .env.test and fill in local values.
#
#   cp test/integration/.env.test.example test/integration/.env.test
#
# Every value here is local-only and disposable. The stack runs on an
# internal Docker network with no egress, and every upstream is WireMock,
# so no real provider credential is ever needed.

COMPOSE_PROJECT_NAME=llmgw-int

LLMGW_HOST=0.0.0.0
LLMGW_PORT=8787
LLMGW_STATE_DIR=/state
LLMGW_CONFIG=/state/config.yaml

# Gateway bearer token used by the console and the smoke checks.
LLMGW_API_KEY=replace-with-a-local-uat-key

LLMGW_ALLOW_UNAUTHENTICATED_API=0

# SSO is exercised through headers injected by the test harness; the shared
# secret only has to match between harness and gateway.
LLMGW_SSO_ENABLED=1
LLMGW_SSO_SHARED_SECRET=replace-with-a-local-sso-secret
LLMGW_SSO_ADMIN_GROUP=llmgw-admin
LLMGW_SSO_AUTO_PROVISION=1

# Must decode to exactly 32 bytes (base64 or hex). Generate a throwaway one:
#   openssl rand -base64 32
LLMGW_CREDENTIAL_ENCRYPTION_KEY=replace-with-32-bytes-base64

LLMGW_ALLOW_COPILOT_PROXY=1
LLMGW_EXPERIMENTAL_COPILOT_PROVIDER=0

LLMGW_LOG_REQUESTS=1
LLMGW_LOG_REQUESTS_MAX_BYTES=10485760

LLMGW_AUTODISCOVER_LOCAL=0
