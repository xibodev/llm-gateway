# Real-integration UAT environment — copy to .env.uat and fill in local values.
#
#   cp test/uat/.env.uat.example test/uat/.env.uat
#
# .env.uat is gitignored. Provider API keys are NOT set here: they are entered
# through the console during UAT (write-once, stored encrypted), which is
# itself part of what UAT validates.

COMPOSE_PROJECT_NAME=llmgw-uat

# Console/admin bearer token. Pick a throwaway value for the UAT session.
LLMGW_API_KEY=replace-with-a-local-uat-admin-key

# Must decode to exactly 32 bytes (base64 or hex). Generate a throwaway one:
#   openssl rand -base64 32
# Required: encrypted provider connections are exercised during UAT.
LLMGW_CREDENTIAL_ENCRYPTION_KEY=replace-with-32-bytes-base64

# Real GitHub Copilot device authorization is part of UAT.
LLMGW_ALLOW_COPILOT_PROXY=1
LLMGW_EXPERIMENTAL_COPILOT_PROVIDER=0

# Static-admin-key mode; SSO is covered by the sealed integration stack.
LLMGW_SSO_ENABLED=0

# Request logs contain metadata only. Never enable body logging with real or
# sensitive prompts unless you explicitly accept cleartext prompt storage.
LLMGW_LOG_REQUEST_BODIES=0
