{
  "schema_version": "1.0.0",
  "proposition": {
    "subject": {
      "id": "llm-gateway",
      "name": "LLM Gateway"
    },
    "assertions": [
      {
        "id": "A1",
        "kind": "cli",
        "target": "cli",
        "description": "the CLI reports release version and build identity",
        "expect": {
          "args": "version",
          "exit_code": 0,
          "stdout_contains": "llm-gateway"
        },
        "supported_by": [
          "cli-version-command"
        ]
      },
      {
        "id": "A2",
        "kind": "cli",
        "target": "cli",
        "description": "the CLI health command verifies local process health",
        "expect": {
          "args": "health",
          "exit_code": 0
        },
        "supported_by": [
          "cli-health-command"
        ]
      },
      {
        "id": "A3",
        "kind": "http",
        "target": "gateway",
        "description": "the gateway exposes an unauthenticated GET /health endpoint reporting status ok",
        "expect": {
          "method": "GET",
          "path": "/health",
          "status": 200,
          "body_contains": "\"status\":\"ok\""
        },
        "supported_by": [
          "http-health-endpoint"
        ]
      },
      {
        "id": "A4",
        "kind": "http",
        "target": "gateway",
        "description": "the gateway serves public models list on GET /v1/models",
        "expect": {
          "method": "GET",
          "path": "/v1/models",
          "status": 200,
          "body_contains": "\"object\":\"list\""
        },
        "supported_by": [
          "http-models-endpoint"
        ]
      }
    ]
  },
  "questions": [
    {
      "id": "Q1",
      "question": "Does /health verify process liveness and build identity independently of upstream provider network availability?",
      "blocking": true,
      "resolution": "Yes, /health is a local process probe returning status ok and build identity without making billable or external upstream provider calls.",
      "resolved_by": "release owner"
    }
  ]
}
