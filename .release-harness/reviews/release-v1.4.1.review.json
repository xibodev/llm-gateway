  "facts": [
    {
      "id": "toolchain",
      "claim": "The module requires Go 1.26.8 and the image builds from golang:1.26.8-alpine and node:22.23.3-alpine, each pinned by index digest. Every workflow sets up Node 22.23.3 and reads the Go release from go/go.mod instead of repeating it. No direct Go or npm dependency had a newer release within its pinned range apart from llmgw-core.",
      "status": "observed",
      "evidence": {
        "source": "git diff v1.4.0..HEAD -- go/go.mod go/Dockerfile .github/workflows"
      }
    },
    {
      "id": "ci-workflows",
      "claim": "Every workflow action moves to its Node 24 release, pinned by commit, with artifact upload (v7.0.1) and download (v8.0.1) moved together; jobs that named ubuntu-latest name ubuntu-24.04. ci.yml still validates every release-harness artifact but no longer checks review coverage; release.yml's validate job still runs lifecycle check before anything is built or published.",
      "status": "observed",
      "evidence": {
        "source": ".github/workflows/ci.yml, .github/workflows/release.yml"
      }
    },
    {
      "id": "azure-fields",
      "claim": "With llmgw-core v1.5.0, Azure OpenAI Chat bodies carry every request property of Azure's v1 Chat Completions operation and service_tier, and no longer carry thinking. The gateway weighs Azure targets with core's AzureChatField, so a field Azure does not define refuses only that target.",
      "status": "observed",
      "evidence": {
        "source": "go/internal/providers/chat_fields.go; llmgw-core v1.5.0 providers/azure_openai.go"
      }
    },
    {
      "id": "retry-after",
      "claim": "Google and Ollama refusals keep the Retry-After core reads, Google refusals keep the retryDelay of a google.rpc.RetryInfo detail on chat, embeddings, images and video, and a fractional wait is rounded up to whole seconds.",
      "status": "observed",
      "evidence": {
        "source": "go/internal/providers/google_provider.go, googleai.go, ollama.go, provider.go"
      }
    },
    {
      "id": "harness-and-tests",
      "claim": "The live-acceptance harness starts the candidate with LLMGW_OPENAI_COMPATIBLE_TIMEOUT_SECONDS at two thirds of its per-model limit. One test fixture renames its demo model, the cancelled-retry test waits a fixed Retry-After, and the harness counts a router model's direct answer as served.",
      "status": "observed",
      "evidence": {
        "source": "test/live-acceptance/core.mjs, test/live-acceptance/run.mjs, go/internal/providers/openai_models_test.go"
      }
    },
    {
      "id": "verification",
      "claim": "At source revision bcd0c5f85f1c5f8987889678d83066d187374d2f: go build, go vet, staticcheck, go test for every package, govulncheck, go mod tidy -diff and go mod verify pass; console typecheck, 154 tests, npm audit and the dist rebuild check pass; the documentation check, actionlint, the acceptance-policy tests (18) and the roster script tests pass; go test -race over every package passes on linux/amd64 with Go 1.26.8; the deterministic Docker acceptance passes all 31 checks against an image built from that revision on a Linux engine, where its digest policy does not apply to a locally built candidate.",
      "status": "observed",
      "evidence": {
        "source": "local and remote Linux test execution"
      }
    }
  ],
