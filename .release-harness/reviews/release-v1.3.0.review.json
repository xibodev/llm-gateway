  "facts": [
    {
      "id": "cli-health-and-models-unchanged",
      "claim": "The version and health subcommands, the /health handler and the GET /v1/models listing and filtering are unchanged; the changes are in the streaming, routing, provider, metering and admission paths of the data-plane completion routes.",
      "status": "observed",
      "evidence": {
        "source": "git diff v1.2.0..HEAD for go/cmd/llmgw, go/internal/buildinfo, go/internal/api/models.go"
      }
    },
    {
      "id": "stream-outcomes",
      "claim": "A stream succeeds only when the upstream ended it and the gateway wrote the surface's terminal event; after headers are sent a failure ends Chat with one error event and no [DONE], Messages with event: error and no message_stop, Responses with response.failed. Such streams are recorded as 502 upstream_stream.",
      "status": "observed",
      "evidence": {
        "source": "go/internal/api/openai.go, anthropic.go, responses_api.go, go/internal/providers/anthropic_failure.go, core_stream.go and stream_outcome_test.go"
      }
    },
    {
      "id": "metering",
      "claim": "Every stream records the tokens it consumed with the served provider and model on every exit (200, 499 client_cancelled, 502 upstream_stream), estimating them when the upstream reports none; failed requests that consumed tokens are charged; native Anthropic streams report exact usage through llm-translate v0.4.0; stream_options reaches the upstream on Chat streams.",
      "status": "observed",
      "evidence": {
        "source": "go/internal/api/stream_usage.go, go/internal/router/savings.go, go/internal/providers/anthropic.go and their tests"
      }
    },
    {
      "id": "deadlines-and-cancellation",
      "claim": "The failover budget covers target selection and the wait for an answer to begin, not the answer; provider timeouts bound the wait for response headers and each gap between body reads; client disconnects cancel native Anthropic and Azure requests; an upstream Retry-After is passed to clients and waited out for at most 5 seconds with full-jitter backoff.",
      "status": "observed",
      "evidence": {
        "source": "go/internal/router/failover.go, go/internal/providers/policy.go, httpstream.go, anthropic.go, azureopenai.go, provider.go and their tests"
      }
    },
    {
      "id": "admission-and-errors",
      "claim": "Request quota is consumed only for requests the gateway executes, after validation; externally managed keys count against project limits; /v1/messages and /v1/messages/count_tokens answer errors in Anthropic's envelope.",
      "status": "observed",
      "evidence": {
        "source": "go/internal/api/keypolicy.go, go/internal/iam/quota.go, go/internal/api/errors.go and their tests"
      }
    },
    {
      "id": "release-gates",
      "claim": "At source revision c474899cc5b81b09c16f7abc6b7e765ad0421b31: go build, go vet, go test for every package, govulncheck, go mod tidy -diff and go mod verify pass; console typecheck, tests and the dist rebuild check pass; the documentation check passes; go test -race over every package passes on linux/amd64 with Go 1.26.6; the deterministic Docker acceptance passes all 31 checks against an image built from that revision on a Linux engine, where its digest policy does not apply to a locally built candidate.",
      "status": "observed",
      "evidence": {
        "source": "local release-gate execution for c474899cc5b81b09c16f7abc6b7e765ad0421b31"
      }
    }
  ],
  "impact": {
    "assertions": [
      {
