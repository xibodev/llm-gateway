  "facts": [
    {
      "id": "deps",
      "claim": "go.mod moves llm-provider-auth from v0.5.0 to v0.6.0 and llmgw-core from v0.10.0 to v0.12.0. llm-provider-auth v0.6.0 replaces the codex package variables with codex.Config and context methods without changing the wire format; llmgw-core v0.11.0 requires the Codex client version, which the gateway already passes, and v0.12.0 is additive with the legacy CodexProvider sharing a transport that sends identical requests.",
      "status": "observed",
      "evidence": {
        "source": "go/go.mod; release notes of llm-provider-auth v0.6.0 and llmgw-core v0.11.0 and v0.12.0"
      }
    },
    {
      "id": "codex-config",
      "claim": "Every codexauth call builds a codex.Config from the same client ID as before and the gateway's Codex endpoints. Production endpoints are the canonical OpenAI URLs; tests override them through SetCodexEndpointsForTests instead of reassigning library variables.",
      "status": "observed",
      "evidence": {
        "source": "go/internal/providers/codex_endpoints.go; go/internal/providers/auth_adapter.go; go/internal/providers/codex.go"
      }
    },
    {
      "id": "strip-removed",
      "claim": "The gateway no longer strips thought signatures before the shared Codex provider, because llmgw-core v0.11.0 and later ignore dropped thought signatures themselves; a test shows a Gemini history is still served by Codex and that no signature reaches it.",
      "status": "observed",
      "evidence": {
        "source": "go/internal/providers/thought_signatures.go; go/internal/providers/codex_test.go"
      }
    },
    {
      "id": "suite",
      "claim": "The full Go suite passes with HTTP_PROXY and HTTPS_PROXY unreachable with unchanged characterization goldens and coupling budgets; gofmt, vet, govulncheck (0 reachable), check-docs and git diff --check pass.",
      "status": "observed",
      "evidence": {
        "source": "local gate run on the reviewed head"
      }
    }
  ],
