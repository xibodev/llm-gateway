  "facts": [
    {
      "id": "copilot-explicit-configuration",
      "claim": "The gateway no longer rewires llm-provider-auth globals from an init hook. A shared Copilot client reads the live settings per operation and applies the cache-directory, OAuth-token and experimental-flag environment fallbacks the library used to apply itself, in the same order.",
      "status": "observed",
      "evidence": {
        "source": "go/internal/providers/copilot_client.go; go/internal/providers/openai_auth.go; TestCopilotSettingsPreserveLibraryEnvironmentFallbacks"
      }
    },
    {
      "id": "copilot-error-text-preserved",
      "claim": "Copilot disabled, missing-token and rejected-token errors keep byte-identical messages, and the rejected-token 401 stays failover-eligible with its status.",
      "status": "observed",
      "evidence": {
        "source": "go/internal/providers/copilot_client_test.go TestCopilotErrorsKeepGatewayGuidance"
      }
    },
    {
      "id": "gcp-token-cache-process-wide",
      "claim": "Vertex service-account access tokens are cached in one process-wide TokenCache keyed by credential and scope, as the former library package cache was, so tokens outlive provider rebuilds.",
      "status": "observed",
      "evidence": {
        "source": "go/internal/providers/factory.go gcpTokens; go/internal/providers/googleai_connection_test.go"
      }
    },
    {
      "id": "provider-auth-dependency",
      "claim": "go.mod pins github.com/xibodev/llm-provider-auth v0.5.0 instead of v0.3.0; llmgw-core v0.6.0 imports only the root and codex packages, which v0.5.0 leaves unchanged.",
      "status": "observed",
      "evidence": {
        "source": "go/go.mod; go/go.sum; llmgw-core v0.6.0 import list"
      }
    },
    {
      "id": "adoption-gates-pass",
      "claim": "gofmt, go build, go vet, the full Go test suite, govulncheck and documentation checks pass with the workspace disabled; the providers config.Get() coupling budget is lowered from 23 to 21.",
      "status": "observed",
      "evidence": {
        "source": "local release gates with GOWORK=off"
      }
    }
  ],
