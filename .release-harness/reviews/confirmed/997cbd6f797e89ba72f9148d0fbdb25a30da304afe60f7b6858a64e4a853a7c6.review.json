  "facts": [
    {
      "id": "additive-store",
      "claim": "iam.CredentialStore implements the llm-provider-auth tokenstore.Store and the llmgw-core CredentialStore over the encrypted provider connections. Nothing outside package iam constructs it yet, so no request path, route or command uses it.",
      "status": "observed",
      "evidence": {
        "source": "go/internal/iam/credential_store.go; no NewCredentialStore call outside go/internal/iam"
      }
    },
    {
      "id": "schema-migration-20",
      "claim": "Migration 20 adds the credential_leases table and changes no existing table. applyMigrations applies only missing versions, so an older binary opens a migrated database unchanged.",
      "status": "observed",
      "evidence": {
        "source": "go/internal/iam/schema.go migrations and applyMigrations"
      }
    },
    {
      "id": "envelope-metadata",
      "claim": "The encrypted OAuth envelope gains an optional metadata member, omitted when empty. OAuthTokenEnvelope.Metadata is tagged json:\"-\", so it never reaches an API response, and existing envelopes decode unchanged.",
      "status": "observed",
      "evidence": {
        "source": "go/internal/iam/oauth.go storedOAuthEnvelope, encodeOAuthEnvelope, decodeOAuthEnvelope"
      }
    },
    {
      "id": "db-open-unchanged",
      "claim": "DB() keeps its caching and behavior; its open-and-migrate body moved into openDB unchanged so tests can open independent handles.",
      "status": "observed",
      "evidence": {
        "source": "go/internal/iam/store.go"
      }
    },
    {
      "id": "suite",
      "claim": "The full Go suite passes with HTTP_PROXY and HTTPS_PROXY unreachable, including the tokenstore storetest conformance suite and differential tests comparing the store writes with the existing refresh, revoke and login writes. gofmt, vet, govulncheck (known unreachable GO-2026-5024 only), check-docs and the coupling budgets pass unchanged.",
      "status": "observed",
      "evidence": {
        "source": "local gate run on the reviewed head"
      }
    }
  ],
