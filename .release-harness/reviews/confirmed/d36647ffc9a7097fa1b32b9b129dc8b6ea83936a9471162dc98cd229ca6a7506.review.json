  "facts": [
    {
      "id": "deps",
      "claim": "go.mod moves llmgw-core from v0.9.0 to v0.10.0 and llm-translate from v0.2.0 to v0.3.0; llm-provider-auth stays at v0.5.0. core v0.10.0 is additive (execution, oauthflow, Credential account fields with redacting formatters); nothing in the gateway prints or encodes a core.Credential outside tests.",
      "status": "observed",
      "evidence": {
        "source": "go/go.mod; release notes of llmgw-core v0.10.0 and llm-translate v0.3.0"
      }
    },
    {
      "id": "decisions-kept",
      "claim": "llm-translate v0.3.0 reports dropped Gemini thought signatures as material. RejectMaterialLossExceptThoughtSignatures ignores only those entries at every call site where one can occur, and the Codex facade strips signatures from copies of the messages before the shared Codex provider, so every request and response the gateway served before is still served with the same upstream payload. Tests pinning this pass on both the old and new versions.",
      "status": "observed",
      "evidence": {
        "source": "go/internal/providers/thought_signatures.go; go/internal/api/vendor_fields_test.go; go/internal/providers/codex_test.go"
      }
    },
    {
      "id": "system-breakpoints",
      "claim": "A Chat request with cache_control on a system text part now reaches an Anthropic upstream with that breakpoint on a system block; message-level cache_control is carried by llm-translate v0.3.0. Requests without cache_control are unchanged.",
      "status": "observed",
      "evidence": {
        "source": "go/internal/providers/anthropic.go and its test"
      }
    },
    {
      "id": "suite",
      "claim": "The full Go suite passes with HTTP_PROXY and HTTPS_PROXY unreachable; characterization goldens and coupling budgets are unchanged. gofmt, vet, govulncheck (0 reachable), check-docs and git diff --check pass.",
      "status": "observed",
      "evidence": {
        "source": "local gate run on the reviewed head"
      }
    }
  ],
