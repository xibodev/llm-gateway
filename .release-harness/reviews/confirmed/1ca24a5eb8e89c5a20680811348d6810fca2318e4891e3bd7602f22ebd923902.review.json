  "facts": [
    {
      "id": "quota-editor-completion",
      "claim": "The administrative console exposes all ten existing-key quota controls. Explicit zero values clear an intrinsic key quota, blank drafts normalize to zero, and negative or unsafe values are rejected; the server API and database schema are unchanged.",
      "status": "observed",
      "evidence": {
        "source": "go/internal/web/console/tests/key-policy-editor.test.mjs and commit c94990333e13e437208465a0a293bb12d3096c77"
      }
    },
    {
      "id": "released-core-audio-contract",
      "claim": "The gateway pins the immutable github.com/xibodev/llmgw-core v1.2.0 module at commit 2a291bb74f05f12f1d0dd8f110f3e1c958f96cd2. That release adds native ElevenLabs transcription and speech, native Xiaomi MiMo speech, and an explicit opt-in chat-model transcription adapter without model-name inference.",
      "status": "observed",
      "evidence": {
        "source": "go/go.mod, go/go.sum, llmgw-core v1.2.0, and llmgw-core providers/translation fixture tests"
      }
    },
    {
      "id": "gateway-audio-dispatch",
      "claim": "The gateway registers ElevenLabs and MiMo as audio-only core verticals, publishes only their exact audio surfaces in the model catalog, and invokes core only when the selected model explicitly declares the requested surface. Existing Edge TTS and OpenAI-compatible audio proxy paths remain the fallback paths.",
      "status": "observed",
      "evidence": {
        "source": "go/internal/providers/audio_vertical.go, go/internal/api/audio.go, and go/internal/api/playground_audio.go"
      }
    },
    {
      "id": "audio-wire-and-auth-tests",
      "claim": "Deterministic gateway tests prove ElevenLabs transcription uses /v1/speech-to-text with xi-api-key and MiMo speech uses /v1/chat/completions with Api-Key and no Authorization header. Core fixture tests cover ElevenLabs speech/transcription success and 429, MiMo speech success and 401, catalog surface declarations, response normalization, and fail-closed transcription opt-in.",
      "status": "observed",
      "evidence": {
        "source": "go/internal/api/audio_test.go and llmgw-core v1.2.0 provider/translation tests"
      }
    },
    {
      "id": "model-list-contract-preserved",
      "claim": "The effective provider registry expands from 25 to 27 entries and can add audio model rows after configuration, while GET /v1/models retains its public list envelope and authorization/filtering behavior. No health route, CLI health, build identity, database migration, or container contract changed.",
      "status": "observed",
      "evidence": {
        "source": "go/internal/providers/registry_snapshot.json, full Go tests, and accepted assertions A1-A4"
      }
    },
    {
      "id": "release-gates",
      "claim": "Against published llmgw-core v1.2.0, full Go tests, Go build, Go vet, govulncheck, console typecheck, all 116 console tests, npm audit, deterministic console-dist verification, documentation checks, and all 15 live-acceptance policy tests pass. The Windows-local race detector is unavailable because CGO/GCC is absent and remains enforced by Linux CI.",
      "status": "observed",
      "evidence": {
        "source": "local release-gate execution for source revision 29e344c3156d246c2039722a05177c56d9065bd3"
      }
    }
  ],
