  "facts": [
    {
      "id": "copy-on-write",
      "claim": "config publishes settings immutably through an atomic pointer paired with a generation. Update, UpdateAndSave, AddProviderIfMissing and Load edit a private deep copy and publish it; readers never lock. Get, Update, UpdateAndSave, AddProviderIfMissing, Load, Save and Provider keep their signatures, and no call site outside internal/config changed.",
      "status": "observed",
      "evidence": {
        "source": "go/internal/config/config.go; git diff between the merge base and HEAD"
      }
    },
    {
      "id": "crash-fixed",
      "claim": "A concurrency test ranging over Get().Providers while writers insert and delete providers crashed with a concurrent map iteration and map write fault on the previous code and passes on this change, including under -count=20.",
      "status": "observed",
      "evidence": {
        "source": "go/internal/config/publish_test.go"
      }
    },
    {
      "id": "restore-cas",
      "claim": "The UpdateAndSave restore returns ErrRestoreSuperseded instead of discarding a change published after the one it would undo; callers already report a failed restore as an incomplete rollback. Every other writer behaves as before for a single writer.",
      "status": "observed",
      "evidence": {
        "source": "go/internal/config/config.go UpdateAndSave; go/internal/api/admin.go delete handler"
      }
    },
    {
      "id": "ci-race",
      "claim": "CI adds a cgo-enabled go test -race step scoped to internal/config. Release builds and the release workflow are unchanged.",
      "status": "observed",
      "evidence": {
        "source": ".github/workflows/ci.yml"
      }
    },
    {
      "id": "suite",
      "claim": "The full Go suite passes with HTTP_PROXY and HTTPS_PROXY unreachable, with unchanged characterization goldens and coupling budgets. The new architecture guard finds no write through a published settings value. gofmt, vet, govulncheck, check-docs and git diff --check pass.",
      "status": "observed",
      "evidence": {
        "source": "local gate run on the reviewed head"
      }
    }
  ],
