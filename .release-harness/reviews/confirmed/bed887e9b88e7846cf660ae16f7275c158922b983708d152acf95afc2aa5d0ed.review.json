  "facts": [
    {
      "id": "planning",
      "claim": "Transport planning in internal/api/transport_mode.go uses llmgw-core's helpers: ParseTransportRequirement and ParseSurfacePath for header and surface parsing (keeping the gateway's 400 text), TransportEvidence with a one-hour freshness window, TransportInterfaces, ListingSurfaces for /v1/models surface lists, and ResponseTransportMode for the X-LLMGW-Transport-Mode label and the playground transport_mode. providers.WireDeclaration supplies each facade's core provider; a test checks every facade's labels come out as before. The gateway's planning functions are removed; transparent pass-through stays on the facades because core's Transparent keys catalogs by credential while the gateway keys them by caller.",
      "status": "observed",
      "evidence": {
        "source": "go/internal/api/transport_mode.go; go/internal/providers/wire_declaration.go and test"
      }
    },
    {
      "id": "catalog",
      "claim": "catalog.json is wrapped as a core ConditionalCatalogStore with the same file format, schema stamp and instance@scope keys, and the gateway's catalogs run in llmgw-core's catalog service with a one-hour TTL, KeepStale and the gateway's rebase rule; catalogCache and its generation fences are removed. core's catalogtest conformance suite passes against the store. /v1/models output and the codex-models golden are unchanged.",
      "status": "observed",
      "evidence": {
        "source": "go/internal/providers catalog store and service; go/internal/api/testdata unchanged"
      }
    },
    {
      "id": "difference",
      "claim": "One behavior change comes from core: concurrent discoveries of the same catalog now run one at a time, so a second reader of a stale catalog waits for and receives the first reader's result instead of fetching again.",
      "status": "observed",
      "evidence": {
        "source": "llmgw-core catalog service"
      }
    },
    {
      "id": "suite",
      "claim": "The full Go suite passes with HTTP_PROXY and HTTPS_PROXY unreachable with unchanged characterization goldens and coupling budgets; gofmt, vet, govulncheck (0 reachable), check-docs and git diff --check pass.",
      "status": "observed",
      "evidence": {
        "source": "local gate run on the reviewed head"
      }
    }
  ],
