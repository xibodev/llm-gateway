  "facts": [
    {
      "id": "classification-only",
      "claim": "InvocationError, ConfigError and StreamRecordTooLargeError gain ProviderErrorClassification and an errors.As view as *core.ProviderError, so llmgw-core can classify gateway failures. The invocation classification reads the predicates the resilience wrapper and the router already act on; the gateway itself never consults core, so no routing, retry or response behavior changes.",
      "status": "observed",
      "evidence": {
        "source": "go/internal/providers/error_classification.go; no production caller of core.ClassifyError in the gateway"
      }
    },
    {
      "id": "parity",
      "claim": "A 115-case parity test pins core's disposition of representative gateway errors (every InvocationError constructor, statuses 400-504, transport, configuration and wrapped errors) to the router's own retry and failover predicates, and documents the two paths where the router decides by surface rather than by error.",
      "status": "observed",
      "evidence": {
        "source": "go/internal/router/classification_parity_test.go"
      }
    },
    {
      "id": "suite",
      "claim": "The full Go suite passes with HTTP_PROXY and HTTPS_PROXY unreachable; characterization goldens and coupling budgets are unchanged. gofmt, vet, govulncheck (0 reachable), check-docs and git diff --check pass.",
      "status": "observed",
      "evidence": {
        "source": "local gate run on the reviewed head"
      }
    }
