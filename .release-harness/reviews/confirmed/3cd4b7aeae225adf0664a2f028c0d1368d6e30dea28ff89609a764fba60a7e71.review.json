  "facts": [
    {
      "id": "type-neutralized",
      "claim": "internal/providers carries providers.CredentialObservation{ConnectionID, CredentialRevision} instead of iam.ProviderAccountObservation in every return value and struct field; one helper converts at each iam producer, and internal/api converts back only where it calls the iam account and check writers. Nil still means no observation, and Codex's zero observation, frozen bearer, Azure and Bedrock observations, the re-read after a 401 refresh and both catalog reads are kept.",
      "status": "observed",
      "evidence": {
        "source": "go/internal/providers/credential_observation.go; go/internal/api/provider_status.go"
      }
    },
    {
      "id": "guards-unchanged",
      "claim": "The IfCurrent guards of RecordProviderAccountSuccessIfCurrent, RecordProviderAccountFailureIfCurrent, RecordProviderCheck and the check-generation rebasing receive the same connection and revision values as before; no inference path starts recording evidence.",
      "status": "observed",
      "evidence": {
        "source": "git diff between the merge base and HEAD"
      }
    },
    {
      "id": "budgets",
      "claim": "The providers iam.* coupling budget moves from 154 to 82; router, api/transport_mode.go, config.Get and config.Principal counts are unchanged.",
      "status": "observed",
      "evidence": {
        "source": "go/internal/architecture/boundary_test.go"
      }
    },
    {
      "id": "suite",
      "claim": "The full Go suite passes with HTTP_PROXY and HTTPS_PROXY unreachable with unchanged characterization goldens; gofmt, vet, govulncheck (0 reachable), check-docs and git diff --check pass.",
      "status": "observed",
      "evidence": {
        "source": "local gate run on the reviewed head"
      }
    }
  ],
