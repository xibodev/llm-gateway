  "facts": [
    {
      "id": "through-runtime",
      "claim": "Google AI Studio and Vertex AI chat and embeddings go through the llmgw-core Runtime with core's Google vertical, registered in the per-type table; image generation calls the vertical's GenerateImages with the credential resolved through the same store; streaming refuses with the existing error; video and the catalog stay on the gateway transport. Upstream request bodies are byte-identical; the gateway's chat, embeddings and image transport code is removed.",
      "status": "observed",
      "evidence": {
        "source": "go/internal/providers/google_vertical.go, googleai.go"
      }
    },
    {
      "id": "new-goldens",
      "claim": "Three new characterization goldens (Google chat, embeddings and images) were recorded with the previous code and pass unchanged with the new code; no existing golden changed.",
      "status": "observed",
      "evidence": {
        "source": "go/internal/api/testdata; commit test(api): characterize Google chat, embeddings and images"
      }
    },
    {
      "id": "credentials",
      "claim": "Credentials resolve in the factory's order (caller connection, system connection, configured key); service-account connections of any casing load as core.TokenTypeGCPServiceAccount and core exchanges them in its own per-instance token cache; other credential kinds are refused as before.",
      "status": "observed",
      "evidence": {
        "source": "go/internal/iam/credential_record.go; go/internal/providers Google tests"
      }
    },
    {
      "id": "deviations",
      "claim": "Edge-case differences: model IDs that are not one URL segment are refused as a configuration error before sending instead of returning an upstream 404; a bad base URL, project or location fails when the provider is built; service-account tokens may be minted separately for chat and embeddings, images, and video or catalog.",
      "status": "observed",
      "evidence": {
        "source": "go/internal/providers Google tests"
      }
    },
    {
      "id": "suite",
      "claim": "The full Go suite passes with HTTP_PROXY and HTTPS_PROXY unreachable with unchanged existing characterization goldens and coupling budgets; gofmt, vet, govulncheck (0 reachable), check-docs and git diff --check pass.",
      "status": "observed",
      "evidence": {
        "source": "local gate run on the reviewed head"
      }
    }
  ],
