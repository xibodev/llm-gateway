  "facts": [
    {
      "id": "cli-and-health-identity",
      "claim": "The version and health subcommands and the /health handler keep their output: version prints the semantic version, source commit and build time, health probes /health on the loopback address, and /health returns status ok with build identity. Every response now also carries X-Content-Type-Options and Referrer-Policy headers.",
      "status": "observed",
      "evidence": {
        "source": "go/cmd/llmgw/main.go, go/internal/buildinfo, go/internal/api/models.go, go/internal/api/security_headers.go and their tests"
      }
    },
    {
      "id": "serve-lifecycle",
      "claim": "serve binds its listener before background workers start, exits with an error when an existing configuration file cannot be read or parsed or a database records a schema newer than the binary, closes idle keep-alive connections after three minutes, and on SIGINT or SIGTERM drains in-flight requests for LLMGW_SHUTDOWN_TIMEOUT_SECONDS (default 25) before closing.",
      "status": "observed",
      "evidence": {
        "source": "go/cmd/llmgw/main.go, go/cmd/llmgw/serve_test.go, go/internal/config/config.go, go/internal/iam/schema.go"
      }
    },
    {
      "id": "models-list-contract",
      "claim": "GET /v1/models keeps its list envelope and its key, project and credential filtering. In unauthenticated local mode a request whose Origin header names a non-loopback host is rejected with 403; requests without an Origin header, as CLIs, SDKs and the release smoke send them, are unaffected.",
      "status": "observed",
